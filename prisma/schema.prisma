generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER")
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts  Account[]
}

model Client {
  id           String        @id @default(cuid())
  name         String
  phone        String
  email        String?
  notes        String?
  source       String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  sessions     Session[]
  student      Student?      // portal hesabı varsa bağlı öğrenci
}

model Appointment {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  title     String
  date      DateTime
  duration  Int      @default(50)
  type      String   @default("ONLINE")
  status    String   @default("PENDING")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  title     String
  date      DateTime
  type      String   @default("ONLINE")
  duration  Int      @default(50)
  status    String   @default("PLANNED")
  notes     String?
  mood      String?
  followUp  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userType  String    // "ADMIN" | "STUDENT"
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Setting {
  id    String @id @default("main")
  key   String @unique
  value String
}

model Student {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  password        String
  gradeLevel      String?  // örn. "LGS", "YKS-Sayısal", "Mezun"
  guardianConsent Boolean  @default(false)
  consentAt       DateTime?
  active          Boolean  @default(true)
  // Portal hesabını (öğrenci) randevu/seans kimliğine (danışan) bağlar.
  // Böylece bir öğrenciye seans yazılabilir ve tüm geçmiş tek kişide toplanır.
  clientId        String?  @unique
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resources       Resource[]
  testimonial     Testimonial?
  works           StudentWork[]
}

model Testimonial {
  id          String   @id @default(cuid())
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rating      Int      // 1-5
  text        String
  displayPref String   @default("NAME")    // NAME | INITIALS
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("LINK")  // LINK | VIDEO | FILE | NOTE
  url         String?                      // LINK / VIDEO / FILE için bağlantı
  body        String?                      // NOTE türü için metin
  category    String?                      // örn. "Çalışma Teknikleri", "Deneme Analizi"
  gradeLevel  String?                      // boş = tüm seviyeler; örn. "LGS", "YKS-Sayısal"
  studentId   String?                      // boş = herkese açık kütüphane; dolu = o öğrenciye özel
  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  published   Boolean  @default(true)
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([gradeLevel])
}

model StudentWork {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      String   @default("NOTE")  // NOTE | LINK | FILE | PHOTO
  title     String?                      // kısa başlık (ör. "Matematik - Türev denemesi")
  note      String?                      // NOTE metni ya da dosya/bağlantı açıklaması
  url       String?                      // LINK için bağlantı, FILE/PHOTO için Blob URL
  fileName  String?                      // yüklenen dosyanın orijinal adı
  fileSize  Int?                         // bayt cinsinden boyut
  seen      Boolean  @default(false)     // koç (admin) gördü mü
  feedback   String?                      // koçun öğrenciye yazdığı değerlendirme
  feedbackAt DateTime?                    // dönüt ne zaman yazıldı/güncellendi
  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([createdAt])
}
